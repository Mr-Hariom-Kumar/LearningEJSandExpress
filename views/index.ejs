<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TOI</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><i>Breaking News</i></h1>
        <%for(let post of posts){%>
            <h4><%=post.headlines%></h4>
            <div><%=post.content%></div>
            <p>~by <%=post.user%></p>
        <%}%>
</body>
</html>