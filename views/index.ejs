<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TOI</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="create"><a href="http://localhost:3000/posts/new">Create your post</a></div>
    <h1>Breaking News</h1>
        <%for(let post of posts){%>
            <h2><%=post.headlines%></h2>
            <div>
                <%=post.content%>
                <a href="http://localhost:3000/posts/<%=post.id%>">Read more</a>
            </div>
            <p>~by <%=post.user%></p>

        <%}%>
</body>
</html>