<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ig user</title>
   <link rel="stylesheet" href="/style.css"/>  <!-- need to be focused for this line specially href -->
</head>
<body>
    <h1>This page belongs to @<%=data.name%></h1>
    <button><%=data.followers%>&nbsp&nbsp Follower</button>&nbsp&nbsp&nbsp&nbsp<button><%=data.following%>&nbsp&nbsp Following</button>
    <hr>
    <%for(let post of data.posts){%>
        <img src="<%=post.image%>">
        <p><b><%=post.likes%>&nbspFollower &nbsp&nbsp&nbsp&nbsp<%=post.comments%>&nbspFollowing</b></p>
    <%}%>
</body>
<script src="/script.js"></script> <!-- need to be focused for this line specially href -->
</html>